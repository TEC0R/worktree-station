{
  "name": "worktree-station",
  "icon": "database",
  "settings": "{\"settings\": \"{\\n  \\\"Prettier-SQL.SQLFlavourOverride\\\": \\\"snowflake\\\",\\n  \\\"[jinja-sql]\\\": {\\n    \\\"editor.tabSize\\\": 4,\\n    \\\"editor.wordWrap\\\": \\\"on\\\"\\n  },\\n  \\\"[jinja-yaml]\\\": {\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[lookml]\\\": {\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"[yaml]\\\": {\\n    \\\"editor.tabSize\\\": 2\\n  },\\n  \\\"chat.mcp.gallery.enabled\\\": true,\\n  \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\n  \\\"claudeCode.hideOnboarding\\\": true,\\n  \\\"claudeCode.lockEditorGroups\\\": false,\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"editor.linkedEditing\\\": true,\\n  \\\"editor.renderWhitespace\\\": \\\"trailing\\\",\\n  \\\"editor.rulers\\\": [\\n    100\\n  ],\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"files.associations\\\": {\\n    \\\"*.sql\\\": \\\"jinja-sql\\\",\\n    \\\"*.yml\\\": \\\"jinja-yaml\\\"\\n  },\\n  \\\"files.autoSave\\\": \\\"onFocusChange\\\",\\n  \\\"files.exclude\\\": {\\n    \\\"**/.DS_Store\\\": true,\\n    \\\"**/.ruff_cache\\\": true,\\n    \\\"**/.pytest_cache\\\": true\\n  },\\n  \\\"files.watcherExclude\\\": {\\n    \\\"**/target/**\\\": true,\\n    \\\"**/dbt_packages/**\\\": true,\\n    \\\"**/logs/**\\\": true,\\n    \\\"**/.ruff_cache/**\\\": true,\\n    \\\"**/.pytest_cache/**\\\": true,\\n    \\\"**/*venv/**\\\": true\\n  },\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.blame.editorDecoration.enabled\\\": true,\\n  \\\"git.branchProtection\\\": [\\n    \\\"staging\\\",\\n    \\\"master\\\",\\n    \\\"main\\\"\\n  ],\\n  \\\"git.confirmSync\\\": false,\\n  \\\"git.pruneOnFetch\\\": true,\\n  \\\"github.copilot.nextEditSuggestions.enabled\\\": true,\\n  \\\"gitlens.currentLine.enabled\\\": false,\\n  \\\"search.exclude\\\": {\\n    \\\"**/target/**\\\": true,\\n    \\\"**/dbt_packages/**\\\": true,\\n    \\\"**/logs/**\\\": true,\\n    \\\"**/*venv/**\\\": true,\\n    \\\"**/tmp/**\\\": true\\n  },\\n  \\\"worktreeStation.dashboardOnStartup\\\": \\\"always\\\",\\n  \\\"task.allowAutomaticTasks\\\": \\\"on\\\",\\n  \\\"task.quickOpen.history\\\": 12,\\n  \\\"terminal.integrated.enablePersistentSessions\\\": false,\\n  \\\"terminal.integrated.scrollback\\\": 20000,\\n  \\\"window.confirmSaveUntitledWorkspace\\\": false,\\n  \\\"window.restoreWindows\\\": \\\"none\\\",\\n  \\\"window.title\\\": \\\"${rootName}${separator}${activeEditorShort}${separator}${dirty}\\\",\\n  \\\"workbench.editor.empty.hint\\\": \\\"hidden\\\",\\n  \\\"workbench.editor.highlightModifiedTabs\\\": true,\\n  \\\"workbench.editor.labelFormat\\\": \\\"medium\\\",\\n  \\\"workbench.secondarySideBar.defaultVisibility\\\": \\\"hidden\\\",\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"workbench.welcomePage.walkthroughs.openOnInstall\\\": false,\\n  \\\"worktreeStation.claudeMode\\\": \\\"window\\\"\\n}\"}",
  "keybindings": "{\"keybindings\": \"[\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+b\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: build (current model)\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+d\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: build + downstream\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+u\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: build + upstream\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+t\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: test (current model)\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+s\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: preview rows\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+c\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: compile (current model)\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+m\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: parse (manifest / lineage)\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+l\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"dbt: changed models\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+f\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"sql: sqlfluff fix\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+k\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"lookml: parse\\\",\\n    \\\"when\\\": \\\"editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+w\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.runTask\\\",\\n    \\\"args\\\": \\\"wts: worktree status\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+x\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.killAll\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"cmd+shift+f12\\\",\\n    \\\"command\\\": \\\"workbench.action.tasks.terminate\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+e\\\",\\n    \\\"command\\\": \\\"worktreeStation.dashboard\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+shift+e\\\",\\n    \\\"command\\\": \\\"workbench.view.extension.worktree-station\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+n\\\",\\n    \\\"command\\\": \\\"worktreeStation.newSession\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+a\\\",\\n    \\\"command\\\": \\\"worktreeStation.buildChanged\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+alt+j\\\",\\n    \\\"command\\\": \\\"worktreeStation.claudeHere\\\"\\n  }\\n]\", \"platform\": 1}",
  "tasks": "{\"tasks\": \"{\\n  \\\"version\\\": \\\"2.0.0\\\",\\n  \\\"tasks\\\": [\\n    {\\n      \\\"label\\\": \\\"dbt: build (current model)\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt build ${fileBasenameNoExtension}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": false\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: build + downstream\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt down ${fileBasenameNoExtension}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": false\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: build + upstream\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt up ${fileBasenameNoExtension}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": false\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: test (current model)\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt test ${fileBasenameNoExtension}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": false\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: preview rows\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt show ${fileBasenameNoExtension} 20\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: compile (current model)\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt compile ${fileBasenameNoExtension}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": false\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: parse (manifest / lineage)\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt parse\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"silent\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"dbt: changed models\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts dbt ls\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"sql: sqlfluff fix\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts fmt ${file}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"silent\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"lookml: parse\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts lkml ${file}\\\",\\n      \\\"options\\\": {\\n        \\\"cwd\\\": \\\"${fileDirname}\\\"\\n      },\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"wts: doctor\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts doctor\\\",\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": true\\n      }\\n    },\\n    {\\n      \\\"label\\\": \\\"wts: worktree status\\\",\\n      \\\"type\\\": \\\"shell\\\",\\n      \\\"command\\\": \\\"wts wt list\\\",\\n      \\\"problemMatcher\\\": [],\\n      \\\"presentation\\\": {\\n        \\\"reveal\\\": \\\"always\\\",\\n        \\\"panel\\\": \\\"dedicated\\\",\\n        \\\"clear\\\": true,\\n        \\\"focus\\\": true\\n      }\\n    }\\n  ]\\n}\"}",
  "snippets": "{\"snippets\": {\"dbt-docs-notion.code-snippets\": \"{\\n  \\\"Push DBT doc to notion\\\": {\\n    \\\"prefix\\\": \\\"push-doc\\\", \\n    \\\"body\\\": [\\n      \\\"I want to generate documentation for this open dbt model and push it to Notion.\\\",\\n      \\\"\\\",\\n      \\\"1. Read the current file logic.\\\",\\n      \\\"2. Read the YAML file and generate the documentation using the template defined in my custom instructions.\\\",\\n    ],\\n    \\\"description\\\": \\\"Prompt AI to push DBT docs to Notion\\\"\\n  }\\n}\", \"dbt-yaml.code-snippets\": \"{\\n  \\\"dbt: model entry (schema.yml)\\\": {\\n    \\\"scope\\\": \\\"yaml,jinja-yaml\\\",\\n    \\\"prefix\\\": \\\"dymodel\\\",\\n    \\\"body\\\": [\\n      \\\"  - name: ${1:model_name}\\\",\\n      \\\"    description: \\\\\\\"${2:What this model is for, at what grain.}\\\\\\\"\\\",\\n      \\\"    columns:\\\",\\n      \\\"      - name: ${3:id}\\\",\\n      \\\"        description: \\\\\\\"${4:Primary key.}\\\\\\\"\\\",\\n      \\\"        data_tests:\\\",\\n      \\\"          - unique\\\",\\n      \\\"          - not_null\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Documented model entry + key tests\\\"\\n  },\\n  \\\"dbt: documented column\\\": {\\n    \\\"scope\\\": \\\"yaml,jinja-yaml\\\",\\n    \\\"prefix\\\": \\\"dycol\\\",\\n    \\\"body\\\": [\\n      \\\"      - name: ${1:column_name}\\\",\\n      \\\"        description: \\\\\\\"${2:Description.}\\\\\\\"\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Column with description\\\"\\n  },\\n  \\\"dbt: test accepted_values\\\": {\\n    \\\"scope\\\": \\\"yaml,jinja-yaml\\\",\\n    \\\"prefix\\\": \\\"dyaccepted\\\",\\n    \\\"body\\\": [\\n      \\\"        data_tests:\\\",\\n      \\\"          - accepted_values:\\\",\\n      \\\"              values: ['${1:a}', '${2:b}']\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Test accepted_values\\\"\\n  },\\n  \\\"dbt: test relationships\\\": {\\n    \\\"scope\\\": \\\"yaml,jinja-yaml\\\",\\n    \\\"prefix\\\": \\\"dyrel\\\",\\n    \\\"body\\\": [\\n      \\\"        data_tests:\\\",\\n      \\\"          - relationships:\\\",\\n      \\\"              to: ref('${1:other_model}')\\\",\\n      \\\"              field: ${2:id}\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Referential integrity test\\\"\\n  },\\n  \\\"dbt: source\\\": {\\n    \\\"scope\\\": \\\"yaml,jinja-yaml\\\",\\n    \\\"prefix\\\": \\\"dysource\\\",\\n    \\\"body\\\": [\\n      \\\"sources:\\\",\\n      \\\"  - name: ${1:source_name}\\\",\\n      \\\"    database: ${2:DATABASE}\\\",\\n      \\\"    schema: ${3:schema}\\\",\\n      \\\"    tables:\\\",\\n      \\\"      - name: ${4:table_name}\\\",\\n      \\\"        description: \\\\\\\"${5:Description.}\\\\\\\"\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Source declaration\\\"\\n  }\\n}\\n\", \"dbt.code-snippets\": \"{\\n  \\\"dbt: config incremental\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dconf-inc\\\",\\n    \\\"body\\\": [\\n      \\\"{{\\\",\\n      \\\"    config(\\\",\\n      \\\"        materialized='incremental',\\\",\\n      \\\"        unique_key='${1:id}',\\\",\\n      \\\"        incremental_strategy='${2|merge,delete+insert,append|}',\\\",\\n      \\\"        on_schema_change='${3|append_new_columns,sync_all_columns,fail,ignore|}',\\\",\\n      \\\"        cluster_by=['${4:updated_at}']\\\",\\n      \\\"    )\\\",\\n      \\\"}}\\\",\\n      \\\"\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Config block for an incremental model\\\"\\n  },\\n  \\\"dbt: config table\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dconf\\\",\\n    \\\"body\\\": [\\n      \\\"{{ config(materialized='${1|table,view,ephemeral|}'${2:, tags=['${3:daily}']}) }}\\\",\\n      \\\"\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Simple config block\\\"\\n  },\\n  \\\"dbt: model skeleton (CTE)\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dmodel\\\",\\n    \\\"body\\\": [\\n      \\\"with source as (\\\",\\n      \\\"    select * from {{ ref('${1:stg_model}') }}\\\",\\n      \\\"),\\\",\\n      \\\"\\\",\\n      \\\"renamed as (\\\",\\n      \\\"    select\\\",\\n      \\\"        ${2:id},\\\",\\n      \\\"        $0\\\",\\n      \\\"    from source\\\",\\n      \\\")\\\",\\n      \\\"\\\",\\n      \\\"select * from renamed\\\"\\n    ],\\n    \\\"description\\\": \\\"dbt model as CTEs, source -> renamed -> final style\\\"\\n  },\\n  \\\"dbt: is_incremental block\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dinc\\\",\\n    \\\"body\\\": [\\n      \\\"{% if is_incremental() %}\\\",\\n      \\\"    where ${1:updated_at} > (select coalesce(max(${1:updated_at}), '1900-01-01') from {{ this }})\\\",\\n      \\\"{% endif %}\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Incremental filter on {{ this }}\\\"\\n  },\\n  \\\"dbt: ref\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dref\\\",\\n    \\\"body\\\": [\\\"{{ ref('${1:model}') }}$0\\\"],\\n    \\\"description\\\": \\\"ref()\\\"\\n  },\\n  \\\"dbt: source\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dsrc\\\",\\n    \\\"body\\\": [\\\"{{ source('${1:schema}', '${2:table}') }}$0\\\"],\\n    \\\"description\\\": \\\"source()\\\"\\n  },\\n  \\\"dbt: snapshot\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dsnap\\\",\\n    \\\"body\\\": [\\n      \\\"{% snapshot ${1:snap_name} %}\\\",\\n      \\\"{{\\\",\\n      \\\"    config(\\\",\\n      \\\"        target_schema='snapshots',\\\",\\n      \\\"        unique_key='${2:id}',\\\",\\n      \\\"        strategy='${3|timestamp,check|}',\\\",\\n      \\\"        updated_at='${4:updated_at}'\\\",\\n      \\\"    )\\\",\\n      \\\"}}\\\",\\n      \\\"\\\",\\n      \\\"select * from {{ source('${5:schema}', '${6:table}') }}\\\",\\n      \\\"\\\",\\n      \\\"{% endsnapshot %}\\\"\\n    ],\\n    \\\"description\\\": \\\"dbt snapshot\\\"\\n  },\\n  \\\"dbt: macro\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"dmacro\\\",\\n    \\\"body\\\": [\\n      \\\"{% macro ${1:macro_name}(${2:arg}) %}\\\",\\n      \\\"    $0\\\",\\n      \\\"{% endmacro %}\\\"\\n    ],\\n    \\\"description\\\": \\\"Jinja macro\\\"\\n  },\\n  \\\"sql: CTE\\\": {\\n    \\\"scope\\\": \\\"jinja-sql,sql\\\",\\n    \\\"prefix\\\": \\\"cte\\\",\\n    \\\"body\\\": [\\n      \\\"${1:name} as (\\\",\\n      \\\"    select\\\",\\n      \\\"        $0\\\",\\n      \\\"    from ${2:table}\\\",\\n      \\\"),\\\"\\n    ],\\n    \\\"description\\\": \\\"Named CTE\\\"\\n  }\\n}\\n\", \"lookml.code-snippets\": \"{\\n  \\\"LookML: view\\\": {\\n    \\\"scope\\\": \\\"lookml,plaintext\\\",\\n    \\\"prefix\\\": \\\"lview\\\",\\n    \\\"body\\\": [\\n      \\\"view: ${1:view_name} {\\\",\\n      \\\"  sql_table_name: ${2:SCHEMA.TABLE} ;;\\\",\\n      \\\"\\\",\\n      \\\"  dimension: ${3:id} {\\\",\\n      \\\"    primary_key: yes\\\",\\n      \\\"    type: string\\\",\\n      \\\"    sql: \\\\\\\\${TABLE}.${3:id} ;;\\\",\\n      \\\"  }\\\",\\n      \\\"\\\",\\n      \\\"  $0\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"LookML view with primary key\\\"\\n  },\\n  \\\"LookML: dimension\\\": {\\n    \\\"scope\\\": \\\"lookml,plaintext\\\",\\n    \\\"prefix\\\": \\\"ldim\\\",\\n    \\\"body\\\": [\\n      \\\"dimension: ${1:name} {\\\",\\n      \\\"  label: \\\\\\\"${2:Label}\\\\\\\"\\\",\\n      \\\"  description: \\\\\\\"${3:Description.}\\\\\\\"\\\",\\n      \\\"  type: ${4|string,number,yesno,tier,location|}\\\",\\n      \\\"  sql: \\\\\\\\${TABLE}.${1:name} ;;\\\",\\n      \\\"}\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Dimension\\\"\\n  },\\n  \\\"LookML: dimension_group\\\": {\\n    \\\"scope\\\": \\\"lookml,plaintext\\\",\\n    \\\"prefix\\\": \\\"ldimg\\\",\\n    \\\"body\\\": [\\n      \\\"dimension_group: ${1:created} {\\\",\\n      \\\"  type: time\\\",\\n      \\\"  timeframes: [raw, time, date, week, month, quarter, year]\\\",\\n      \\\"  sql: \\\\\\\\${TABLE}.${1:created}_at ;;\\\",\\n      \\\"}\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Time dimension group\\\"\\n  },\\n  \\\"LookML: measure\\\": {\\n    \\\"scope\\\": \\\"lookml,plaintext\\\",\\n    \\\"prefix\\\": \\\"lmeas\\\",\\n    \\\"body\\\": [\\n      \\\"measure: ${1:name} {\\\",\\n      \\\"  label: \\\\\\\"${2:Label}\\\\\\\"\\\",\\n      \\\"  description: \\\\\\\"${3:Description.}\\\\\\\"\\\",\\n      \\\"  type: ${4|count,sum,average,count_distinct,number|}\\\",\\n      \\\"  sql: \\\\\\\\${${5:field}} ;;\\\",\\n      \\\"}\\\",\\n      \\\"$0\\\"\\n    ],\\n    \\\"description\\\": \\\"Measure\\\"\\n  },\\n  \\\"LookML: explore + join\\\": {\\n    \\\"scope\\\": \\\"lookml,plaintext\\\",\\n    \\\"prefix\\\": \\\"lexplore\\\",\\n    \\\"body\\\": [\\n      \\\"explore: ${1:explore_name} {\\\",\\n      \\\"  label: \\\\\\\"${2:Label}\\\\\\\"\\\",\\n      \\\"\\\",\\n      \\\"  join: ${3:joined_view} {\\\",\\n      \\\"    type: left_outer\\\",\\n      \\\"    relationship: ${4|many_to_one,one_to_many,one_to_one,many_to_many|}\\\",\\n      \\\"    sql_on: \\\\\\\\${${1:explore_name}.${5:id}} = \\\\\\\\${${3:joined_view}.${5:id}} ;;\\\",\\n      \\\"  }\\\",\\n      \\\"  $0\\\",\\n      \\\"}\\\"\\n    ],\\n    \\\"description\\\": \\\"Explore with one join\\\"\\n  }\\n}\\n\"}}",
  "extensions": "[{\"identifier\": {\"id\": \"altimateai.vscode-altimate-mcp-server\"}}, {\"identifier\": {\"id\": \"anthropic.claude-code\"}}, {\"identifier\": {\"id\": \"eamodio.gitlens\"}}, {\"identifier\": {\"id\": \"esbenp.prettier-vscode\"}}, {\"identifier\": {\"id\": \"google.colab\"}}, {\"identifier\": {\"id\": \"inferrinizzard.prettier-sql-vscode\"}}, {\"identifier\": {\"id\": \"innoverio.vscode-dbt-power-user\"}}, {\"identifier\": {\"id\": \"mechatroner.rainbow-csv\"}}, {\"identifier\": {\"id\": \"ms-python.debugpy\"}}, {\"identifier\": {\"id\": \"ms-python.python\"}}, {\"identifier\": {\"id\": \"ms-python.vscode-pylance\"}}, {\"identifier\": {\"id\": \"ms-python.vscode-python-envs\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter-keymap\"}}, {\"identifier\": {\"id\": \"ms-toolsai.jupyter-renderers\"}}, {\"identifier\": {\"id\": \"ms-toolsai.vscode-jupyter-cell-tags\"}}, {\"identifier\": {\"id\": \"ms-toolsai.vscode-jupyter-slideshow\"}}, {\"identifier\": {\"id\": \"rvest.vs-code-prettier-eslint\"}}, {\"identifier\": {\"id\": \"samuelcolvin.jinjahtml\"}}, {\"identifier\": {\"id\": \"tec0r.worktree-station\"}}]",
